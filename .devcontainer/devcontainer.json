{
    "name": "Claudio v2.1",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "devcontainer",
    "workspaceFolder": "/workspace",
    "remoteUser": "dev",
    // Generate build provenance in .env before docker-compose build
    "initializeCommand": ".devcontainer/generate-build-env.sh",
    // Docker-outside-of-docker for container management
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    // Persistent volumes — external, survive rebuilds and down -v
    "mounts": [
        "source=claudio-dev,target=/home/dev/.claudio,type=volume",
        "source=claudio-history,target=/commandhistory,type=volume"
    ],
    // Note: init-claudio and firewall init are handled by docker-entrypoint.sh
    // VS Code customizations
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh",
                "editor.formatOnSave": true
            },
            "extensions": [
                "anthropic.claude-code",
                "ms-azuretools.vscode-docker",
                "eamodio.gitlens"
            ]
        }
    }
}