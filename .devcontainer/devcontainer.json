{
    "name": "Claudio v2.1",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "devcontainer",
    "workspaceFolder": "/workspace",
    "remoteUser": "dev",
    // Docker-outside-of-docker for container management
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    // Per-container volumes (override standalone volumes)
    // These use ${devcontainerId} which only works in devcontainer.json
    "mounts": [
        "source=claudio-${devcontainerId},target=/home/dev/.claudio,type=volume",
        "source=claudio-history-${devcontainerId},target=/commandhistory,type=volume",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/dev/.ssh-host,type=bind,readonly",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gnupg,target=/home/dev/.gnupg-host,type=bind,readonly"
    ],
    // SSH agent forwarding from host
    "remoteEnv": {
        "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}"
    },
    // Initialization (runs after container start)
    "postCreateCommand": "init-claudio",
    // Optional: enable network firewall (set CLAUDIO_FIREWALL=true in .env)
    "postStartCommand": "[ \"${CLAUDIO_FIREWALL:-false}\" = \"true\" ] && sudo /usr/local/bin/init-firewall.sh || true",
    // VS Code customizations
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh",
                "editor.formatOnSave": true
            },
            "extensions": [
                "anthropic.claude-code",
                "ms-azuretools.vscode-docker",
                "eamodio.gitlens"
            ]
        }
    }
}