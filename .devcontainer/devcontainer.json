{
    "name": "claudio (Claude Code)",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "devcontainer",
    "workspaceFolder": "/workspace",
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },
    "mounts": [
        "source=claudio-claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
        "source=claudio-bashhistory-${devcontainerId},target=/commandhistory,type=volume"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
    },
    "postCreateCommand": "bash -c 'init-claude-settings.sh && sudo npm -g i @anthropic-ai/claude-code && claude --version'",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "ms-azuretools.vscode-docker"
            ]
        }
    }
}