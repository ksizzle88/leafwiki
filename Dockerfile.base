# syntax=docker/dockerfile:1
# Claudio Base Image v2.1 - Simplified foundation for Claude Code development
#
# Usage:
#   ./build-base.sh              # Builds claudio-base:latest
#   docker run --rm claudio-base:latest claude --version
#
# Projects can:
#   - Use directly: "image": "ghcr.io/ksizzle88/claudio:latest"
#   - Extend: FROM ghcr.io/ksizzle88/claudio:latest

FROM mcr.microsoft.com/devcontainers/base:ubuntu-24.04

# Build args - User configuration
ARG DEV_USER=dev
ARG DEV_UID=1000
ARG DEV_GID=1000
ARG DEV_HOME=/home/dev
ARG DEV_PASSWORD=dev

# Build args - Tools and versions
ARG DEBIAN_FRONTEND=noninteractive
ARG NODE_VERSION=22
ARG ZSH_IN_DOCKER_VERSION=1.2.0

# Build args - Git configuration
ARG GIT_USER_EMAIL
ARG GIT_USER_NAME
ARG GIT_GPG_SIGN=false
ARG GIT_SIGNING_KEY

# Layer 1: Rename default vscode user to configurable name
# The Microsoft devcontainer base creates 'vscode' user - we rename it
RUN usermod -l ${DEV_USER} -d ${DEV_HOME} -m vscode 2>/dev/null || true \
    && groupmod -n ${DEV_USER} vscode 2>/dev/null || true \
    && sed -i "s/vscode/${DEV_USER}/g" /etc/sudoers.d/* 2>/dev/null || true \
    && echo "${DEV_USER}:${DEV_PASSWORD}" | chpasswd

# Layer 2: System dependencies (changes infrequently)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        # Core utilities
        ca-certificates \
        curl \
        git \
        openssh-client \
        jq \
        wget \
        make \
        nano \
        vim \
        # Shell enhancements
        zsh \
        fzf \
        tmux \
        unzip \
        # Dev tools
        strace \
        direnv \
        yq \
        # Build essentials (for native modules)
        build-essential \
        libpq-dev \
        # Python (Ubuntu 24.04 native 3.12)
        python3 \
        python3-dev \
        python3-venv \
        python3-pip \
        # Init system (PID 1 zombie reaper + signal forwarding)
        tini \
        # Firewall tools (for security layer)
        iptables \
        ipset \
        iproute2 \
        dnsutils \
        # Claude Code sandbox dependencies
        bubblewrap \
        socat \
    && rm -rf /var/lib/apt/lists/*

# Layer 3: Python aliases and pip upgrade
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3 1 \
    && python -m pip install --upgrade --break-system-packages --ignore-installed pip setuptools wheel

# Layer 4: Node.js installation (via NodeSource)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Layer 5: GitHub CLI installation (via GitHub's official repository)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    mkdir -p /usr/share/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# Layer 6: AWS CLI v2 (for SSM, infrastructure management)
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/aws /tmp/awscliv2.zip

# Layer 7: Doppler CLI (secrets management)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    curl -fsSL https://cli.doppler.com/install.sh | sh

# Layer 7b: uv (ultra-fast pip/venv replacement)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && mv /root/.local/bin/uvx /usr/local/bin/uvx

# Layer 7c: Bun runtime (for Telegram channel MCP server and other plugins)
RUN curl -fsSL https://bun.sh/install | bash \
    && mv /root/.bun/bin/bun /usr/local/bin/bun \
    && ln -sf /usr/local/bin/bun /usr/local/bin/bunx

# Layer 8: Environment configuration
# Note: CLAUDE_CONFIG_DIR uses $HOME at runtime, not hardcoded path
ENV npm_config_update_notifier=false \
    npm_config_fund=false \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SHELL=/bin/zsh \
    EDITOR=nano \
    VISUAL=nano

# Layer 9: User-writable npm global prefix (matches Anthropic/Node.js Docker best practices)
RUN mkdir -p /usr/local/share/npm-global \
    && chown -R ${DEV_USER}:${DEV_USER} /usr/local/share/npm-global
ENV NPM_CONFIG_PREFIX=/usr/local/share/npm-global
ENV PATH=$PATH:/usr/local/share/npm-global/bin

# Layer 10: AI Coding CLIs (auto-updates work via user-owned npm prefix)
# - Claude Code (Anthropic): https://claude.ai/code
# - Codex CLI (OpenAI): https://openai.com/codex
# - Sandbox runtime: seccomp filter for Claude Code sandbox mode
USER ${DEV_USER}
RUN npm install -g @anthropic-ai/claude-code @openai/codex task-master-ai @anthropic-ai/sandbox-runtime
USER root

# Layer 11: Shell history directory
RUN mkdir -p /commandhistory \
    && touch /commandhistory/.zsh_history \
    && touch /commandhistory/.bash_history \
    && chown -R ${DEV_USER}:${DEV_USER} /commandhistory

# Layer 12: Zsh configuration (as dev user)
USER ${DEV_USER}
RUN sh -c "$(wget -O- https://github.com/deluan/zsh-in-docker/releases/download/v${ZSH_IN_DOCKER_VERSION}/zsh-in-docker.sh)" -- \
    -p git \
    -p fzf \
    -a "source /usr/share/doc/fzf/examples/key-bindings.zsh 2>/dev/null || true" \
    -a "source /usr/share/doc/fzf/examples/completion.zsh 2>/dev/null || true" \
    -a "export HISTFILE=/commandhistory/.zsh_history" \
    -a "export HISTSIZE=10000" \
    -a "export SAVEHIST=10000" \
    -a "export CLAUDE_CODE_TASK_LIST_ID=main" \
    -a "export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1" \
    -a 'export PATH="$HOME/.claude/bin:$PATH"' \
    -x
USER root

# Layer 13: Claudio CLI (management tool)
COPY cli/ /usr/local/lib/claudio/
RUN chmod +x /usr/local/lib/claudio/claudio 2>/dev/null || true \
    && chmod +x /usr/local/lib/claudio/commands/*.sh 2>/dev/null || true \
    && chmod +x /usr/local/lib/claudio/lib/*.sh 2>/dev/null || true \
    && chmod +x /usr/local/lib/claudio/scripts/*.sh 2>/dev/null || true \
    && ln -sf /usr/local/lib/claudio/claudio /usr/local/bin/claudio

# Layer 14: Initialization scripts and entrypoint
COPY .devcontainer/install-claudio.sh /usr/local/bin/install-claudio.sh
COPY .devcontainer/init-firewall.sh /usr/local/bin/init-firewall.sh
COPY .devcontainer/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY cli/scripts/init-claudio-v3.sh /usr/local/bin/init-claudio
COPY cli/scripts/task-master-wrapper.sh /usr/local/bin/task-master
COPY cli/scripts/wait-for-output.sh /usr/local/bin/wait-for-output
RUN chmod +x /usr/local/bin/install-claudio.sh \
    && chmod +x /usr/local/bin/init-firewall.sh \
    && chmod +x /usr/local/bin/docker-entrypoint.sh \
    && chmod +x /usr/local/bin/init-claudio \
    && chmod +x /usr/local/bin/task-master \
    && chmod +x /usr/local/bin/wait-for-output

# Layer 15: Sudoers for firewall (passwordless)
RUN echo "${DEV_USER} ALL=(root) NOPASSWD: /usr/local/bin/init-firewall.sh" \
    > /etc/sudoers.d/${DEV_USER}-firewall \
    && chmod 0440 /etc/sudoers.d/${DEV_USER}-firewall

# Layer 16: Shared Claude config defaults (includes statusline scripts)
COPY .claude/ /opt/claudio-defaults/.claude/
RUN chmod +x /opt/claudio-defaults/.claude/statusline.sh 2>/dev/null || true \
    && chmod +x /opt/claudio-defaults/.claude/statusline-command.sh 2>/dev/null || true \
    && chmod +x /opt/claudio-defaults/.claude/fetch-usage.sh 2>/dev/null || true \
    && chown -R ${DEV_USER}:${DEV_USER} /opt/claudio-defaults/

# Layer 17: User directory setup
RUN mkdir -p ${DEV_HOME}/.claude ${DEV_HOME}/.claudio ${DEV_HOME}/.history \
    && chown -R ${DEV_USER}:${DEV_USER} ${DEV_HOME}/.claude ${DEV_HOME}/.claudio ${DEV_HOME}/.history

# Layer 18: Git configuration (as dev user)
USER ${DEV_USER}
RUN git config --global init.defaultBranch main \
    && git config --global push.autoSetupRemote true \
    && git config --global --add safe.directory /workspace \
    && git config --global --add safe.directory '/workspace/*' \
    && if [ -n "$GIT_USER_EMAIL" ]; then git config --global user.email "$GIT_USER_EMAIL"; fi \
    && if [ -n "$GIT_USER_NAME" ]; then git config --global user.name "$GIT_USER_NAME"; fi \
    && git config --global commit.gpgsign "$GIT_GPG_SIGN" \
    && git config --global tag.gpgsign "$GIT_GPG_SIGN" \
    && if [ -n "$GIT_SIGNING_KEY" ]; then git config --global user.signingkey "$GIT_SIGNING_KEY"; fi
USER root

# Runtime configuration
# Entrypoint runs as root to fix volume permissions, then drops to dev user
WORKDIR ${DEV_HOME}
ENTRYPOINT ["tini", "--", "/usr/local/bin/docker-entrypoint.sh"]

# Healthcheck
HEALTHCHECK --interval=2m --timeout=5s --start-period=10s --retries=3 \
    CMD command -v claude >/dev/null

# Build provenance (declared last to avoid cache busting)
ARG BUILD_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG BUILD_BRANCH=unknown
ARG BUILD_TAG=dev
ARG BUILD_HOSTNAME=unknown

# OCI-standard labels for image metadata
LABEL org.opencontainers.image.revision="${BUILD_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${BUILD_TAG}" \
      org.opencontainers.image.source="https://github.com/ksizzle88/claudio" \
      org.opencontainers.image.title="Claudio" \
      org.opencontainers.image.description="Production-ready devcontainer for Claude Code development" \
      com.claudio.build.branch="${BUILD_BRANCH}" \
      com.claudio.build.hostname="${BUILD_HOSTNAME}"

# Write build provenance to /etc/claudio-release (shell-sourceable KEY=VALUE format)
RUN echo "BUILD_COMMIT=${BUILD_COMMIT}" > /etc/claudio-release \
    && echo "BUILD_DATE=${BUILD_DATE}" >> /etc/claudio-release \
    && echo "BUILD_BRANCH=${BUILD_BRANCH}" >> /etc/claudio-release \
    && echo "BUILD_TAG=${BUILD_TAG}" >> /etc/claudio-release \
    && echo "BUILD_HOSTNAME=${BUILD_HOSTNAME}" >> /etc/claudio-release
