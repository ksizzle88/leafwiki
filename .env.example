# Git Configuration (baked into claudio-base:latest image)
# Copy this file to .env and fill in your details:
#   cp .env.example .env
#
# Then rebuild the base image:
#   ./build-base.sh

GIT_USER_EMAIL=your.email@example.com
GIT_USER_NAME=Your Name

# Container Registry Configuration (for automated build/push on git push)
# Requires a GitHub Personal Access Token with 'write:packages' scope
# Create token at: https://github.com/settings/tokens/new
#
# Enable/disable automated builds:
REGISTRY_ENABLED=false

# Registry settings (GitHub Container Registry):
REGISTRY_URL=ghcr.io
REGISTRY_USERNAME=your-github-username

# Optional: Override auto-detected repository name
# (defaults to git remote repo name, e.g., 'claudio' from github.com/user/claudio.git)
# REGISTRY_IMAGE_NAME=custom-name

# GitHub Personal Access Token (PAT) with 'write:packages' scope:
GITHUB_PACKAGE_PAT=ghp_your_token_here

# Optional: Control build behavior
# Protected branches (main, master, develop, stage) auto-skip local builds by default
# GitHub Actions will build them instead. To force local build on protected branches:
# SKIP_PROTECTED_BRANCH=false git push origin main
#
# To skip any build manually (works on all branches):
# SKIP_IMAGE_BUILD=true git push
