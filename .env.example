# Git Configuration
# Copy this file to .env and fill in your details:
#   cp .env.example .env
#
# Two modes available (set in devcontainer.json):
#   1. GIT_USE_PROJECT_CONFIG=true  - Uses these env vars (for claudio, homebase, homebase-infra)
#   2. GIT_USE_PROJECT_CONFIG=false - Syncs with shared volume from Windows host (default for other containers)
#
# For project-specific identity, set these in your shell or .env:

GIT_USER_EMAIL=your.email@example.com
GIT_USER_NAME=Your Name

# Devcontainer remote user password (used for interactive auth inside container)
# Change this before sharing images outside local development.
DEV_PASSWORD=dev

# Network Firewall (optional - restricts outbound to allowlist only)
# Set to 'true' to enable iptables firewall on container start
CLAUDIO_FIREWALL=false

# GPG Signing Configuration (optional - for verified commits)
# Set to 'true' to enable commit signing, 'false' to disable
# Requires GPG keys mounted at runtime (see devcontainer.json mounts)
GIT_GPG_SIGN=false
# Your GPG signing key ID (get with: gpg --list-secret-keys --keyid-format=long)
# Example: GIT_SIGNING_KEY=3AA5C34371567BD2
GIT_SIGNING_KEY=

# Container Registry Configuration (for automated build/push on git push)
# Requires a GitHub Personal Access Token with 'write:packages' scope
# Create token at: https://github.com/settings/tokens/new
#
# Enable/disable automated builds:
REGISTRY_ENABLED=false

# Registry settings (GitHub Container Registry):
REGISTRY_URL=ghcr.io
REGISTRY_USERNAME=your-github-username

# Optional: Override auto-detected repository name
# (defaults to git remote repo name, e.g., 'claudio' from github.com/user/claudio.git)
# REGISTRY_IMAGE_NAME=custom-name

# GitHub Personal Access Token (PAT) with 'write:packages' scope:
GITHUB_PACKAGE_PAT=ghp_your_token_here

# Optional: Control build behavior
# Protected branches (main, master, develop, stage) auto-skip local builds by default
# GitHub Actions will build them instead. To force local build on protected branches:
# SKIP_PROTECTED_BRANCH=false git push origin main
#
# To skip any build manually (works on all branches):
# SKIP_IMAGE_BUILD=true git push

# ============================================================================
# Manual Build and Push Configuration (for ./build-base.sh --push)
# ============================================================================
# Use these settings when manually building and pushing with build-base.sh
#
# Default registry URL for --push flag (defaults to ghcr.io/ksizzle88/claudio)
# REGISTRY_URL=ghcr.io/ksizzle88/claudio
#
# GitHub Personal Access Token for registry authentication
# Create token at: https://github.com/settings/tokens/new
# Scopes needed: write:packages
# GHCR_TOKEN=ghp_your_token_here
#
# Usage examples:
#   ./build-base.sh --push                           # Push to default registry
#   ./build-base.sh --tags latest v1.0.0 --push      # Push multiple tags
#   ./build-base.sh --push --registry custom.io/repo # Push to custom registry

# ============================================================================
# MCP Server Configuration (for Claude Code integrations)
# ============================================================================
# These environment variables are used by MCP servers configured in .mcp.json
# See .claude/mcp.json.example for configuration examples
#
# MCP servers can access these via the 'env' field in their configuration

# GitHub Integration (for @modelcontextprotocol/server-github)
# Create token at: https://github.com/settings/tokens/new
# Scopes needed: repo, read:org, read:user
GITHUB_TOKEN=

# Brave Search API (for @modelcontextprotocol/server-brave-search)
# Get API key at: https://brave.com/search/api/
BRAVE_API_KEY=

# Slack Integration (for @modelcontextprotocol/server-slack)
# Create app at: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Google Integration (for @modelcontextprotocol/server-google-*)
# Create credentials at: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Database connections (for database MCP servers)
# PostgreSQL (if using postgres service in docker-compose.yml)
DATABASE_URL=postgresql://postgres:dev@postgres:5432/dev_db
# SQLite (local database files)
SQLITE_DB_PATH=/workspace/data/app.db

# API Keys for other MCP servers
# Add your custom MCP server environment variables here
# Example: CUSTOM_API_KEY=your-api-key-here
