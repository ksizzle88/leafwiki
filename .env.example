# Git Configuration (baked into claudio-base:latest image)
# Copy this file to .env and fill in your details:
#   cp .env.example .env
#
# Then rebuild the base image:
#   ./build-base.sh

GIT_USER_EMAIL=your.email@example.com
GIT_USER_NAME=Your Name

# Container Registry Configuration (for automated build/push on git push)
# Requires a GitHub Personal Access Token with 'write:packages' scope
# Create token at: https://github.com/settings/tokens/new
#
# Enable/disable automated builds:
REGISTRY_ENABLED=false

# Registry settings (GitHub Container Registry):
REGISTRY_URL=ghcr.io
REGISTRY_USERNAME=your-github-username
REGISTRY_IMAGE_NAME=claudio

# GitHub Personal Access Token (PAT) with 'write:packages' scope:
GITHUB_PAT=ghp_your_token_here

# Optional: Skip a specific build without disabling entirely
# Usage: SKIP_IMAGE_BUILD=true git push origin main
# SKIP_IMAGE_BUILD=false
