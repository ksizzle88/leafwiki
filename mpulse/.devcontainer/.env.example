# mpulse devcontainer environment configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==========================================
# Claudio Base Image
# Controls which Claudio base image the mpulse Dockerfile builds FROM.
# CLAUDIO_IMAGE: registry/repo (default: ghcr.io/ksizzle88/claudio)
# CLAUDIO_TAG:   image tag (default: develop)
#
# For local builds: set both to use your locally-built image
#   ./build-base.sh --tags local
#   CLAUDIO_IMAGE=claudio-base
#   CLAUDIO_TAG=local
# ==========================================
# CLAUDIO_IMAGE=claudio-base
# CLAUDIO_TAG=local

# ==========================================
# Config Home Directory
# For Windows configs in WSL2, use: /mnt/c/Users/your-windows-username
# Leave unset or comment out to use WSL home directory (default)
# ==========================================
CONFIG_HOME=/mnt/c/Users/KeithSchepis

# ==========================================
# SSH Agent Forwarding (Windows)
# To use Windows SSH agent in the container, you need npiperelay + socat
# See setup instructions below
# ==========================================
# SSH_AGENT_SOCK_PATH=/home/dev/.ssh/agent.sock

# ==========================================
# Timezone
# ==========================================
TZ=America/New_York

# ==========================================
# Snowflake Connection
# Used by DPI_Analytics_DBT (dbt) and data-pipelines/snowflake-export
# ==========================================
SNOWFLAKE_ACCOUNT=your-account.region
SNOWFLAKE_USER=your.username@mpulse.com
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=YOUR_DATABASE
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=YOUR_ROLE

# ==========================================
# AWS Configuration
# Credentials are mounted from ~/.aws (read-only bind mount)
# Set profile/region here if needed
# ==========================================
AWS_PROFILE=default
AWS_REGION=us-east-1

# ==========================================
# Git Identity (if overriding host config)
# Leave blank to use identity from shared Claudio gitconfig volume
# ==========================================
GIT_USER_EMAIL=
GIT_USER_NAME=
GIT_GPG_SIGN=false
GIT_SIGNING_KEY=
