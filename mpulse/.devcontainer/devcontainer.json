{
    "name": "mpulse (Claudio)",
    "dockerComposeFile": "docker-compose.yml",
    "service": "devcontainer",
    "workspaceFolder": "/workspace",
    "remoteUser": "dev",
    "initializeCommand": "docker volume inspect claudio-shared >/dev/null 2>&1 || echo 'WARNING: claudio-shared volume not found.'; curl -sf http://localhost:9999/health >/dev/null 2>&1 && echo 'MSSQL Proxy: running' || echo 'WARNING: MSSQL Proxy not running. Start it: cd mpulse/.tools/mssql-proxy && start.bat'",
    "customizations": {
        "vscode": {
            "settings": {
                "workbench.colorCustomizations": {
                    "titleBar.activeBackground": "#1a5276",
                    "titleBar.activeForeground": "#ffffff",
                    "activityBar.background": "#1a5276",
                    "statusBar.background": "#154360"
                },
                "terminal.integrated.defaultProfile.linux": "zsh",
                "editor.formatOnSave": true,
                "python.defaultInterpreterPath": "/opt/mpulse-venv/bin/python",
                "editor.rulers": [
                    120
                ],
                "[sql]": {
                    "editor.defaultFormatter": "dorzey.vscode-sqlfluff"
                },
                "dbt.queryLimit": 500,
                "dbt.queryTemplate": "select * from ({query}) as query limit {limit}",
                "snowflake.connectionsConfigFile": "/home/dev/.snowflake/connections.toml",
                "markdown.preview.scrollEditorWithPreview": false,
                "markdown.preview.scrollPreviewWithEditor": false,
                "markdown.preview.markEditorSelection": false,
                "markdown.preview.doubleClickToSwitchToEditor": false,
                "aws.suppressPrompts": { "codeWhispererConnectionExpired": true },
                "aws.codeWhisperer.shareCodeWhispererContentWithAWS": false,
                "amazonQ.telemetry": false,
                "aws.cfn.lint.enabled": false,
                "yaml.languageserver.enabled": false
            },
            "extensions": [
                "anthropic.claude-code",
                "ms-python.python",
                "ms-python.pylance",
                "innoverio.vscode-dbt-power-user",
                "dorzey.vscode-sqlfluff",
                "hashicorp.terraform",
                "ms-azuretools.vscode-docker",
                "eamodio.gitlens",
                "redhat.vscode-yaml",
                "snowflake.snowflake-vsc",
                "charliermarsh.ruff",
                "AmazonWebServices.aws-toolkit-vscode",
                "mkhl.direnv",
                "bierner.markdown-mermaid"
            ]
        }
    }
}