#!/usr/bin/env bash
set -euo pipefail

# snow-2-claude: Run a SQL file via Snowflake CLI, save dual output for Claude.
#
# Usage: snow-2-claude [--dry-run] [filename] [-c connection] [-t timeout]
#        snow-2-claude clean [--dry-run] [-c connection]
#
#   filename     SQL file to run (default: run.sql)
#                Resolved relative to /tmp/claude/snowflake/{project}/
#   -c conn      Snowflake connection profile (REQUIRED — determines env subfolder)
#   -t timeout   Timeout in seconds (default: 120)
#   --dry-run    Print the command that would be executed, but don't run it
#   clean        Remove all .sql, .json, and -out.txt files from the snowflake directory
#
# Output: Always runs with JSON format internally, produces two files:
#   {name}-out.json  Raw JSON (for Claude to parse programmatically)
#   {name}-out.txt   Markdown table (human-readable, fixed-width)
#
# Directory: /tmp/claude/snowflake/{project}/{env}/
#   {project} = basename of git repo root (or auto-detected from SQL path)
#   {env}     = derived from connection name (e.g., mp_de_qa → qa)

usage() {
    sed -n '3,22p' "$0" | sed 's/^# \?//'
    exit "${1:-0}"
}

# --- Resolve project name from git root or PWD ---
resolve_project_name() {
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"
    basename "$root"
}

# --- Map connection name to env subfolder ---
connection_to_env() {
    local conn="$1"
    case "$conn" in
        mp_de_qa)       echo "qa" ;;
        mp_de_stage)    echo "stage" ;;
        mp_de_prod)     echo "prod" ;;
        data_ops_dev)   echo "data_ops_dev" ;;
        data_ops_prod)  echo "data_ops_prod" ;;
        dpi_ml_prod)    echo "dpi_ml_prod" ;;
        edw-develop)    echo "edw_develop" ;;
        *)              echo "$conn" ;;
    esac
}

# --- Convert JSON array to markdown table (with column padding) ---
json_to_table() {
    local json_file="$1"
    local max_rows="${2:-0}"  # 0 = all rows

    # Bail if empty or not valid JSON array
    if ! jq -e 'type == "array" and length > 0' "$json_file" >/dev/null 2>&1; then
        echo "(no rows returned)"
        return
    fi

    local total_rows
    total_rows=$(jq 'length' "$json_file")

    # Get headers
    local -a headers
    mapfile -t headers < <(jq -r '.[0] | keys_unsorted[]' "$json_file")

    # Calculate column widths (header length or max value length, whichever is larger)
    local -a widths
    for i in "${!headers[@]}"; do
        local hdr="${headers[$i]}"
        local max_val_len
        max_val_len=$(jq -r --arg k "$hdr" '[.[][$k] | tostring | length] | max // 0' "$json_file")
        local hdr_len=${#hdr}
        widths[$i]=$(( max_val_len > hdr_len ? max_val_len : hdr_len ))
        # Cap at 40 chars to prevent absurdly wide columns
        (( widths[$i] > 40 )) && widths[$i]=40
    done

    # Build header row
    local header_line="| "
    local separator="| "
    for i in "${!headers[@]}"; do
        header_line+="$(printf "%-${widths[$i]}s" "${headers[$i]}") | "
        separator+="$(printf '%0.s-' $(seq 1 "${widths[$i]}")) | "
    done

    echo "$header_line"
    echo "$separator"

    # Build data rows
    local row_limit=$total_rows
    if (( max_rows > 0 && max_rows < total_rows )); then
        row_limit=$max_rows
    fi

    jq -r --argjson limit "$row_limit" '
        .[:$limit][] |
        [to_entries[] | .value // "" | tostring | .[:40]] |
        @tsv
    ' "$json_file" | while IFS=$'\t' read -ra vals; do
        local line="| "
        for i in "${!vals[@]}"; do
            local w="${widths[$i]:-10}"
            line+="$(printf "%-${w}s" "${vals[$i]}")"
            line+=" | "
        done
        echo "$line"
    done

    if (( max_rows > 0 && total_rows > max_rows )); then
        echo "... ($max_rows of $total_rows rows shown)"
    fi
}

# --- Resolve snowflake directory (requires env) ---
resolve_snowflake_dir() {
    local env="$1"
    echo "/tmp/claude/snowflake/$(resolve_project_name)/$env"
}

# --- Handle "clean" subcommand ---
if [[ "${1:-}" == "clean" ]]; then
    shift
    dry_run=false
    connection=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            -c) connection="$2"; shift 2 ;;
            *) echo "Unknown option: $1" >&2; usage 1 ;;
        esac
    done

    # If connection given, clean that env; otherwise clean entire project dir
    project_dir="/tmp/claude/snowflake/$(resolve_project_name)"
    if [[ -n "$connection" ]]; then
        snowflake_dir="$project_dir/$(connection_to_env "$connection")"
    else
        snowflake_dir="$project_dir"
    fi

    if [[ ! -d "$snowflake_dir" ]]; then
        echo "Nothing to clean: $snowflake_dir does not exist"
        exit 0
    fi

    files=()
    while IFS= read -r -d '' f; do
        files+=("$f")
    done < <(find "$snowflake_dir" \( -name '*.sql' -o -name '*-out.txt' -o -name '*-out.json' \) -print0 2>/dev/null)

    if [[ ${#files[@]} -eq 0 ]]; then
        echo "Nothing to clean in $snowflake_dir"
        exit 0
    fi

    echo "Snowflake dir: $snowflake_dir"
    echo ""
    for f in "${files[@]}"; do
        if $dry_run; then
            echo "  would delete: $(basename "$f")"
        else
            echo "  deleting: $(basename "$f")"
            rm "$f"
        fi
    done

    echo ""
    if $dry_run; then
        echo "${#files[@]} file(s) would be deleted. Run without --dry-run to delete."
    else
        echo "${#files[@]} file(s) deleted."
    fi
    exit 0
fi

# --- Parse arguments ---
sql_file=""
connection=""
dry_run=false
timeout_secs=120

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) dry_run=true; shift ;;
        -c) connection="$2"; shift 2 ;;
        -t) timeout_secs="$2"; shift 2 ;;
        -h|--help) usage 0 ;;
        -f) echo "Note: -f flag is deprecated. Output is always dual (JSON + table)." >&2; shift 2 ;;
        -*) echo "Unknown option: $1" >&2; usage 1 ;;
        *)
            if [[ -z "$sql_file" ]]; then
                sql_file="$1"
            else
                echo "Error: unexpected argument '$1'" >&2; usage 1
            fi
            shift
            ;;
    esac
done

if [[ -z "$connection" ]]; then
    echo "Error: -c connection is required (determines env subfolder)" >&2
    usage 1
fi

sql_file="${sql_file:-run.sql}"
env="$(connection_to_env "$connection")"

# --- Resolve directories ---
base_dir="/tmp/claude/snowflake/$(resolve_project_name)"
out_dir="$(resolve_snowflake_dir "$env")"
mkdir -p "$out_dir"

# --- Resolve SQL file path ---
# Search order: absolute, CWD, project dir, env dir, then scan all project dirs
sql_path=""
if [[ "$sql_file" == /* ]] && [[ -f "$sql_file" ]]; then
    sql_path="$sql_file"
elif [[ -f "$sql_file" ]]; then
    sql_path="$(pwd)/$sql_file"
elif [[ -f "$base_dir/$sql_file" ]]; then
    sql_path="$base_dir/$sql_file"
elif [[ -f "$out_dir/$sql_file" ]]; then
    sql_path="$out_dir/$sql_file"
else
    # Fallback: scan all project dirs under /tmp/claude/snowflake/
    for d in /tmp/claude/snowflake/*/; do
        [[ -d "$d" ]] || continue
        if [[ -f "$d$sql_file" ]]; then
            sql_path="$d$sql_file"
            base_dir="${d%/}"
            out_dir="$base_dir/$env"
            mkdir -p "$out_dir"
            break
        fi
        if [[ -f "$d$env/$sql_file" ]]; then
            sql_path="$d$env/$sql_file"
            base_dir="${d%/}"
            out_dir="$base_dir/$env"
            break
        fi
    done
fi

if [[ -z "$sql_path" ]]; then
    echo "Error: SQL file not found. Searched:" >&2
    echo "  $(pwd)/$sql_file" >&2
    echo "  $base_dir/$sql_file" >&2
    echo "  $out_dir/$sql_file" >&2
    echo "  /tmp/claude/snowflake/*/$sql_file" >&2
    echo "  /tmp/claude/snowflake/*/$env/$sql_file" >&2
    exit 1
fi

# --- Output paths (dual: JSON + table) ---
sql_basename="$(basename "$sql_file" .sql)"
json_path="$out_dir/${sql_basename}-out.json"
table_path="$out_dir/${sql_basename}-out.txt"

# --- Build snow command (always JSON internally) ---
snow_args=(sql -f "$sql_path" --format JSON -c "$connection")

# --- Run it ---
echo "--- snow-2-claude ---"
echo "  SQL:    $sql_path"
echo "  Conn:   $connection ($env)"
echo "  Timeout: ${timeout_secs}s"
echo "---------------------"

if $dry_run; then
    echo "  [dry-run] would execute: snow ${snow_args[*]}"
    echo "  JSON output: $json_path"
    echo "  Table output: $table_path"
    exit 0
fi

# Run snow with timeout
snow_exit=0
timeout "$timeout_secs" snow "${snow_args[@]}" > "$json_path" 2>&1 || snow_exit=$?

echo ""
if [[ $snow_exit -eq 124 ]]; then
    echo "ERROR: Query timed out after ${timeout_secs}s" | tee -a "$json_path"
    echo "  If auth expired, re-authenticate: snow connection test -c ${connection}"
    echo "  Partial output (if any) saved to: $json_path"
    exit 1
elif [[ $snow_exit -ne 0 ]]; then
    echo "ERROR: snow exited with code $snow_exit"
    echo "  Output: $json_path"
    cat "$json_path" >&2
    exit "$snow_exit"
fi

# --- Post-process: generate markdown table from JSON ---
if jq -e 'type == "array"' "$json_path" >/dev/null 2>&1; then
    row_count=$(jq 'length' "$json_path")
    echo "  Rows: $row_count"
    echo ""

    # Write full table to file
    json_to_table "$json_path" 0 > "$table_path"

    # Print first 20 rows to console
    json_to_table "$json_path" 20

    echo ""
    echo "  JSON:  $json_path"
    echo "  Table: $table_path"
else
    # Non-array output (DDL, status messages, etc.) — save as-is
    cp "$json_path" "$table_path"
    echo "  Output (non-tabular):"
    head -20 "$json_path"
    echo ""
    echo "  Output: $json_path"
fi

printf '\a'
