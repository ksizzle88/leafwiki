#!/usr/bin/env bash
set -euo pipefail

# mssql-2-claude: Run a SQL file against SQL Server via proxy, save output for Claude to read.
#
# Usage: mssql-2-claude [--dry-run] [filename] -c connection [-f format] [-t timeout]
#        mssql-2-claude clean [--dry-run] [-c connection]
#        mssql-2-claude connections
#
#   filename     SQL file to run (default: run.sql)
#   -c conn      Connection profile from ~/.mssql-2-claude.toml (REQUIRED)
#   -f format    Output format: TABLE, JSON, CSV (default: TABLE)
#   -t timeout   Query timeout in seconds (default: 120)
#   --dry-run    Print the command that would be executed, but don't run it
#   clean        Remove all .sql and -out.txt files
#   connections  List available connection profiles
#
# Directory: /tmp/claude/sqlserver/{project}/{env}/
#   {project} = basename of git repo root
#   {env}     = connection profile name

usage() {
    sed -n '3,19p' "$0" | sed 's/^# \?//'
    exit "${1:-0}"
}

CONFIG_FILE="$HOME/.mssql-2-claude.toml"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PYTHON_RUNNER="$SCRIPT_DIR/mssql-runner.py"

# --- Resolve project name from git root or PWD ---
resolve_project_name() {
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"
    basename "$root"
}

# --- Resolve output directory ---
resolve_out_dir() {
    local env="$1"
    echo "/tmp/claude/sqlserver/$(resolve_project_name)/$env"
}

# --- Handle "connections" subcommand ---
if [[ "${1:-}" == "connections" ]]; then
    if [[ ! -f "$CONFIG_FILE" ]]; then
        echo "No config file found at $CONFIG_FILE"
        echo ""
        echo "Create one with connection profiles and proxy settings. Example:"
        echo ""
        echo '  [proxy]'
        echo '  url = "http://host.docker.internal:8080/query"'
        echo ''
        echo '  [connections.edw_qa]'
        echo '  server = "edw-qa.example.com"'
        echo '  database = "EDW"'
        echo '  # additional fields passed to proxy as connection params'
        exit 0
    fi
    python3 -c "
import tomllib, sys
with open('$CONFIG_FILE', 'rb') as f:
    cfg = tomllib.load(f)
proxy = cfg.get('proxy', {})
print(f'Proxy: {proxy.get(\"url\", \"(not configured)\")}')
print()
conns = cfg.get('connections', {})
if not conns:
    print('No connections defined in $CONFIG_FILE')
    sys.exit(0)
print(f'Available connections ({len(conns)}):')
for name, c in conns.items():
    server = c.get('server', '?')
    db = c.get('database', '?')
    print(f'  {name:20s} {server}/{db}')
"
    exit 0
fi

# --- Handle "clean" subcommand ---
if [[ "${1:-}" == "clean" ]]; then
    shift
    dry_run=false
    connection=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            -c) connection="$2"; shift 2 ;;
            *) echo "Unknown option: $1" >&2; usage 1 ;;
        esac
    done

    project_dir="/tmp/claude/sqlserver/$(resolve_project_name)"
    if [[ -n "$connection" ]]; then
        target_dir="$project_dir/$connection"
    else
        target_dir="$project_dir"
    fi

    if [[ ! -d "$target_dir" ]]; then
        echo "Nothing to clean: $target_dir does not exist"
        exit 0
    fi

    files=()
    while IFS= read -r -d '' f; do
        files+=("$f")
    done < <(find "$target_dir" \( -name '*.sql' -o -name '*-out.txt' \) -print0 2>/dev/null)

    if [[ ${#files[@]} -eq 0 ]]; then
        echo "Nothing to clean in $target_dir"
        exit 0
    fi

    echo "SQL Server dir: $target_dir"
    echo ""
    for f in "${files[@]}"; do
        if $dry_run; then
            echo "  would delete: $(basename "$f")"
        else
            echo "  deleting: $(basename "$f")"
            rm "$f"
        fi
    done

    echo ""
    if $dry_run; then
        echo "${#files[@]} file(s) would be deleted. Run without --dry-run to delete."
    else
        echo "${#files[@]} file(s) deleted."
    fi
    exit 0
fi

# --- Parse arguments ---
sql_file=""
connection=""
format="TABLE"
dry_run=false
timeout_secs=120

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) dry_run=true; shift ;;
        -c) connection="$2"; shift 2 ;;
        -f) format="$2"; shift 2 ;;
        -t) timeout_secs="$2"; shift 2 ;;
        -h|--help) usage 0 ;;
        -*) echo "Unknown option: $1" >&2; usage 1 ;;
        *)
            if [[ -z "$sql_file" ]]; then
                sql_file="$1"
            else
                echo "Error: unexpected argument '$1'" >&2; usage 1
            fi
            shift
            ;;
    esac
done

if [[ -z "$connection" ]]; then
    echo "Error: -c connection is required" >&2
    usage 1
fi

sql_file="${sql_file:-run.sql}"

# --- Resolve directories ---
base_dir="/tmp/claude/sqlserver/$(resolve_project_name)"
out_dir="$(resolve_out_dir "$connection")"
mkdir -p "$out_dir"

# --- Resolve SQL file path ---
# Search order: absolute path, CWD, base project dir, env subfolder
if [[ "$sql_file" == /* ]]; then
    sql_path="$sql_file"
elif [[ -f "$sql_file" ]]; then
    sql_path="$(pwd)/$sql_file"
elif [[ -f "$base_dir/$sql_file" ]]; then
    sql_path="$base_dir/$sql_file"
elif [[ -f "$out_dir/$sql_file" ]]; then
    sql_path="$out_dir/$sql_file"
else
    echo "Error: SQL file not found. Searched:" >&2
    echo "  $(pwd)/$sql_file" >&2
    echo "  $base_dir/$sql_file" >&2
    echo "  $out_dir/$sql_file" >&2
    exit 1
fi

# --- Output always goes to the env subfolder ---
sql_basename="$(basename "$sql_file" .sql)"
out_path="$out_dir/${sql_basename}-out.txt"

# --- Run it ---
echo "--- mssql-2-claude ---"
echo "  SQL:    $sql_path"
echo "  Output: $out_path"
echo "  Format: $format"
echo "  Conn:   $connection"
echo "  Timeout: ${timeout_secs}s"
echo "---------------------"

if $dry_run; then
    echo "  [dry-run] would execute: python3 $PYTHON_RUNNER -c $connection -f $format -t $timeout_secs $sql_path"
    exit 0
fi

if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: Config file not found: $CONFIG_FILE" >&2
    echo "Run 'mssql-2-claude connections' for setup instructions." >&2
    exit 1
fi

mssql_exit=0
python3 "$PYTHON_RUNNER" \
    --config "$CONFIG_FILE" \
    --connection "$connection" \
    --format "$format" \
    --timeout "$timeout_secs" \
    --sql-file "$sql_path" \
    2>&1 | tee "$out_path" || mssql_exit=$?

echo ""
if [[ $mssql_exit -ne 0 ]]; then
    echo "ERROR: mssql-runner exited with code $mssql_exit" | tee -a "$out_path"
    echo "  Output (if any) saved to: $out_path"
    exit "$mssql_exit"
fi

echo "Output saved to: $out_path"
printf '\a'
