#!/usr/bin/env bash
set -euo pipefail

# tf-2-claude: Run terraform commands and save output for Claude to analyze.
#
# All output files (tfplan.out, tfplan.json, *-out.txt) go to .dev/tf/
# relative to the working directory (the environment root).
# Terraform always runs from the working directory where *.tf files live.
#
# Usage: tf-2-claude [--dry-run] plan [-target=ADDR] [-parallelism=N] [-refresh=false] ...
#        tf-2-claude [--dry-run] init [-upgrade] [-migrate-state]
#        tf-2-claude [--dry-run] apply [tfplan.out]
#        tf-2-claude analyze <command> [--filter PAT] [--module MOD] [--limit N]
#        tf-2-claude [--dry-run] state-list [--filter PATTERN]
#        tf-2-claude [--dry-run] state-show <address>
#        tf-2-claude [--dry-run] state-rm <address> [address...]
#        tf-2-claude [--dry-run] validate
#        tf-2-claude [--dry-run] output [name]
#        tf-2-claude clean [--dry-run] [--cache]
#
# Commands:
#   plan   (p)    Run terraform plan, generate tfplan.out + tfplan.json,
#                 then auto-run summary + issues analysis.
#                 Default: -parallelism=10. All terraform plan flags pass through.
#   init          Run terraform init (with optional flags)
#   apply         Run terraform apply (defaults to .dev/tf/tfplan.out if it exists)
#   analyze       Run tfplan.py analysis (any command + filters)
#   state-list    Run terraform state list, save to .dev/tf/state-list-out.txt
#   state-show    Run terraform state show, save to .dev/tf/state-show-out.txt
#   state-rm      Run terraform state rm, save to .dev/tf/state-rm-out.txt
#   validate      Run terraform validate, save to .dev/tf/validate-out.txt
#   output        Run terraform output, save to .dev/tf/output-out.txt
#   clean         Remove .dev/tf/ contents (tfplan.out, tfplan.json, *-out.txt)
#
# Shortcuts (pass through to analyze):
#   s=summary  m=modules  r=resources  i=imports  d=details
#   u=updates  x=issues   df=diff      dr=drift   st=status
#
# Global Options:
#   --dry-run     Print the command that would be executed, but don't run it
#
# Plan Options (terraform flags pass through):
#   -target=ADDR       Target a specific resource/module (repeatable)
#   -parallelism=N     Concurrent operations (default: 10)
#   -refresh=false     Skip state refresh (fast iteration)
#   --no-analyze       Skip auto-analysis after plan (tf-2-claude flag)

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
TFPLAN_PY="$SCRIPT_DIR/tfplan.py"
DRY_RUN=false
OUT_DIR=".dev/tf"

ensure_out_dir() {
    mkdir -p "$OUT_DIR"
}

elapsed_time() {
    local start=$1
    local end
    end=$(date +%s)
    echo "$((end - start))s"
}

format_bytes() {
    local size=$1
    if [[ $size -gt 1048576 ]]; then
        echo "$(( size / 1048576 ))MB"
    elif [[ $size -gt 1024 ]]; then
        echo "$(( size / 1024 ))KB"
    else
        echo "${size}B"
    fi
}

usage() {
    sed -n '3,43p' "$0" | sed 's/^# \?//'
    exit "${1:-0}"
}

banner() {
    local label=$1
    echo "--- tf-2-claude $label ---"
    echo "  Dir:    $(pwd)"
    echo "  Output: $OUT_DIR/"
}

# --- Subcommand: clean ---
cmd_clean() {
    local include_cache=false
    for arg in "$@"; do
        [[ "$arg" == "--cache" ]] && include_cache=true
        [[ "$arg" == "--dry-run" ]] && DRY_RUN=true
    done

    if [[ ! -d "$OUT_DIR" ]]; then
        echo "Nothing to clean — $OUT_DIR/ does not exist."
        return 0
    fi

    local files=()
    for f in "$OUT_DIR"/tfplan.out "$OUT_DIR"/tfplan.json "$OUT_DIR"/tfplan.prev.json "$OUT_DIR"/*-out.txt; do
        [[ -f "$f" ]] && files+=("$f")
    done
    if $include_cache; then
        for f in "$OUT_DIR"/.*.cache.json; do
            [[ -f "$f" ]] && files+=("$f")
        done
    fi

    if [[ ${#files[@]} -eq 0 ]]; then
        echo "Nothing to clean in $OUT_DIR/"
        return 0
    fi

    echo "Directory: $OUT_DIR/"
    echo ""
    local total_size=0
    for f in "${files[@]}"; do
        local size
        size=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f" 2>/dev/null || echo 0)
        total_size=$((total_size + size))
        if $DRY_RUN; then
            echo "  would delete: $f ($(format_bytes "$size"))"
        else
            echo "  deleting: $f ($(format_bytes "$size"))"
            rm "$f"
        fi
    done

    echo ""
    if $DRY_RUN; then
        echo "${#files[@]} file(s) would be deleted ($(format_bytes "$total_size"))."
    else
        echo "${#files[@]} file(s) deleted ($(format_bytes "$total_size"))."
    fi
}

# --- Subcommand: init ---
cmd_init() {
    local init_args=(init)

    for arg in "$@"; do
        case "$arg" in
            --upgrade|-upgrade) init_args+=(-upgrade) ;;
            --migrate-state|-migrate-state) init_args+=(-migrate-state) ;;
            *) echo "Unknown init option: $arg" >&2; exit 1 ;;
        esac
    done

    ensure_out_dir
    banner "init"
    echo "  Args: terraform ${init_args[*]}"
    echo "------------------------"

    if $DRY_RUN; then
        echo "  [dry-run] would execute: terraform ${init_args[*]}"
        return 0
    fi

    terraform "${init_args[@]}" 2>&1 | tee "$OUT_DIR/init-out.txt"

    echo ""
    echo "Output saved to: $OUT_DIR/init-out.txt"
    printf '\a'
}

# --- Subcommand: plan ---
cmd_plan() {
    local no_analyze=false
    local has_parallelism=false
    local tf_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-analyze)          no_analyze=true; shift ;;
            -target|--target|-t)   tf_args+=("-target=$2"); shift 2 ;;
            -parallelism=*)        has_parallelism=true; tf_args+=("$1"); shift ;;
            -*)                    tf_args+=("$1"); shift ;;
            *)                     tf_args+=("$1"); shift ;;
        esac
    done

    if ! $has_parallelism; then
        tf_args+=("-parallelism=10")
    fi

    local plan_args=(plan -out "$OUT_DIR/tfplan.out" "${tf_args[@]}")

    ensure_out_dir
    banner "plan"
    echo "  Command: terraform ${plan_args[*]}"
    echo "------------------------"

    if $DRY_RUN; then
        echo "  [dry-run] would execute: terraform ${plan_args[*]}"
        echo "  [dry-run] would execute: terraform show -json $OUT_DIR/tfplan.out > $OUT_DIR/tfplan.json"
        if ! $no_analyze; then
            echo "  [dry-run] would execute: python3 $TFPLAN_PY report summary,issues[,diff,status] $OUT_DIR/tfplan.json --save-dir $OUT_DIR"
        fi
        return 0
    fi

    local plan_start
    plan_start=$(date +%s)

    # Save previous plan for diff comparison
    if [[ -f "$OUT_DIR/tfplan.json" ]]; then
        cp "$OUT_DIR/tfplan.json" "$OUT_DIR/tfplan.prev.json"
    fi

    # Remove stale outputs so agents never read outdated data
    rm -f "$OUT_DIR/tfplan.json" "$OUT_DIR/plan-summary-out.txt" \
          "$OUT_DIR/plan-issues-out.txt" "$OUT_DIR/tfplan.out" \
          "$OUT_DIR/.tfplan.cache.json"

    terraform "${plan_args[@]}" 2>&1 | tee "$OUT_DIR/plan-out.txt"
    local plan_exit=${PIPESTATUS[0]}

    if [[ $plan_exit -ne 0 ]]; then
        # Extract error lines for quick reading
        if [[ -f "$OUT_DIR/plan-out.txt" ]]; then
            sed 's/\x1b\[[0-9;]*m//g' "$OUT_DIR/plan-out.txt" \
                | grep -A 10 -E '╷|Error:|Warning:' \
                > "$OUT_DIR/plan-errors.txt" 2>/dev/null || true
        fi
        echo ""
        echo "Plan failed (exit $plan_exit) in $(elapsed_time $plan_start)."
        echo "Output: $OUT_DIR/plan-out.txt"
        [[ -s "$OUT_DIR/plan-errors.txt" ]] && echo "Errors: $OUT_DIR/plan-errors.txt"
        printf '\a'
        return $plan_exit
    fi

    echo ""
    echo "Generating tfplan.json..."
    terraform show -json "$OUT_DIR/tfplan.out" > "$OUT_DIR/tfplan.json"

    echo "Plan completed in $(elapsed_time $plan_start)"
    echo "Plan output saved to: $OUT_DIR/plan-out.txt"
    echo "Plan binary saved to: $OUT_DIR/tfplan.out"
    echo "Plan JSON saved to:   $OUT_DIR/tfplan.json"

    if ! $no_analyze && [[ -f "$TFPLAN_PY" ]]; then
        echo ""

        local report_cmds="summary,issues"
        [[ -f "$OUT_DIR/tfplan.prev.json" ]] && report_cmds="${report_cmds},diff"
        report_cmds="${report_cmds},status"

        python3 "$TFPLAN_PY" report "$report_cmds" "$OUT_DIR/tfplan.json" \
            --save-dir "$OUT_DIR" --generate-approved 2>&1 | tee "$OUT_DIR/plan-report-out.txt"

        echo "Analysis saved to: $OUT_DIR/plan-*-out.txt"
        echo ""
        echo "Drill deeper:"
        echo "  tf-2-claude s                        # summary"
        echo "  tf-2-claude m                        # modules"
        echo "  tf-2-claude d -f PATTERN             # details"
        echo "  tf-2-claude u --pending              # unresolved updates"
        echo "  tf-2-claude st                       # migration status"
        echo "  tf-2-claude df                       # diff vs previous"
    fi

    printf '\a'
}

# --- Subcommand: apply ---
cmd_apply() {
    local apply_args=(apply)
    local plan_file="${1:-}"

    if [[ -z "$plan_file" && -f "$OUT_DIR/tfplan.out" ]]; then
        plan_file="$OUT_DIR/tfplan.out"
    fi

    [[ -n "$plan_file" ]] && apply_args+=("$plan_file")

    ensure_out_dir
    banner "apply"
    echo "  Command: terraform ${apply_args[*]}"
    echo "-------------------------"

    if $DRY_RUN; then
        echo "  [dry-run] would execute: terraform ${apply_args[*]}"
        return 0
    fi

    terraform "${apply_args[@]}" 2>&1 | tee "$OUT_DIR/apply-out.txt"

    echo ""
    echo "Apply output saved to: $OUT_DIR/apply-out.txt"
    printf '\a'
}

# --- Subcommand: analyze ---
cmd_analyze() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: tf-2-claude analyze <command> [options]"
        echo ""
        echo "Commands: summary, modules, resources, imports, details,"
        echo "          drift, moved, updates, issues, diff"
        echo ""
        echo "Options:"
        echo "  --filter PATTERN   Filter by resource address (regex)"
        echo "  --module MODULE    Filter by module path"
        echo "  --action ACTION    Filter by action (create/update/delete/replace)"
        echo "  --limit N          Limit output to N resources"
        echo "  --json             JSON output (updates only)"
        exit 1
    fi

    local analysis_cmd="$1"
    shift

    if [[ ! -f "$TFPLAN_PY" ]]; then
        echo "Error: tfplan.py not found at $TFPLAN_PY" >&2
        exit 1
    fi

    if [[ ! -f "$OUT_DIR/tfplan.json" ]]; then
        echo "Error: $OUT_DIR/tfplan.json not found. Run 'tf-2-claude plan' first." >&2
        exit 1
    fi

    ensure_out_dir
    local out_file="$OUT_DIR/analyze-${analysis_cmd}-out.txt"

    banner "analyze"
    echo "  Command: $analysis_cmd"
    echo "---------------------------"

    if $DRY_RUN; then
        echo "  [dry-run] would execute: python3 $TFPLAN_PY $analysis_cmd $OUT_DIR/tfplan.json $*"
        return 0
    fi

    local analyze_start
    analyze_start=$(date +%s)

    python3 "$TFPLAN_PY" "$analysis_cmd" "$OUT_DIR/tfplan.json" "$@" 2>&1 | tee "$out_file"

    echo ""
    echo "Analysis saved to: $out_file ($(elapsed_time $analyze_start))"
    printf '\a'
}

# --- Subcommand: state-list ---
cmd_state_list() {
    local filter=""
    if [[ "${1:-}" == "--filter" && -n "${2:-}" ]]; then
        filter="$2"
    fi

    ensure_out_dir
    banner "state-list"
    echo "------------------------------"

    if $DRY_RUN; then
        echo "  [dry-run] would execute: terraform state list"
        return 0
    fi

    if [[ -n "$filter" ]]; then
        terraform state list 2>&1 | grep -i "$filter" | tee "$OUT_DIR/state-list-out.txt"
    else
        terraform state list 2>&1 | tee "$OUT_DIR/state-list-out.txt"
    fi

    local count
    count=$(wc -l < "$OUT_DIR/state-list-out.txt")
    echo ""
    echo "$count resources in state. Saved to: $OUT_DIR/state-list-out.txt"
    printf '\a'
}

# --- Subcommand: state-show ---
cmd_state_show() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: tf-2-claude state-show <address>" >&2
        exit 1
    fi

    local address="$1"

    ensure_out_dir
    banner "state-show"
    echo "  Address: $address"
    echo "------------------------------"

    if $DRY_RUN; then
        echo "  [dry-run] would execute: terraform state show '$address'"
        return 0
    fi

    terraform state show "$address" 2>&1 | tee "$OUT_DIR/state-show-out.txt"

    echo ""
    echo "State show saved to: $OUT_DIR/state-show-out.txt"
    printf '\a'
}

# --- Subcommand: state-rm ---
cmd_state_rm() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: tf-2-claude state-rm <address> [address...]" >&2
        exit 1
    fi

    ensure_out_dir
    banner "state-rm"
    echo "  Addresses: $*"
    echo "----------------------------"

    if $DRY_RUN; then
        for addr in "$@"; do
            echo "  [dry-run] would execute: terraform state rm '$addr'"
        done
        return 0
    fi

    for addr in "$@"; do
        echo "Removing: $addr"
        terraform state rm "$addr" 2>&1 | tee -a "$OUT_DIR/state-rm-out.txt"
        echo ""
    done

    echo "State rm output saved to: $OUT_DIR/state-rm-out.txt"
    printf '\a'
}

# --- Subcommand: validate ---
cmd_validate() {
    ensure_out_dir
    banner "validate"
    echo "----------------------------"

    if $DRY_RUN; then
        echo "  [dry-run] would execute: terraform validate"
        return 0
    fi

    terraform validate 2>&1 | tee "$OUT_DIR/validate-out.txt"

    echo ""
    echo "Validate output saved to: $OUT_DIR/validate-out.txt"
    printf '\a'
}

# --- Subcommand: output ---
cmd_output() {
    local output_args=(output)
    local output_name="${1:-}"
    local out_file="$OUT_DIR/output-out.txt"

    if [[ -n "$output_name" ]]; then
        output_args+=("$output_name")
        out_file="$OUT_DIR/output-${output_name}-out.txt"
    fi

    ensure_out_dir
    banner "output"
    echo "  Command: terraform ${output_args[*]}"
    echo "--------------------------"

    if $DRY_RUN; then
        echo "  [dry-run] would execute: terraform ${output_args[*]}"
        return 0
    fi

    terraform "${output_args[@]}" 2>&1 | tee "$out_file"

    echo ""
    echo "Output saved to: $out_file"
    printf '\a'
}

# --- Main dispatch ---
if [[ $# -lt 1 ]]; then
    usage 1
fi

# Parse global --dry-run before subcommand
if [[ "$1" == "--dry-run" ]]; then
    DRY_RUN=true
    shift
fi

if [[ $# -lt 1 ]]; then
    usage 1
fi

cmd="$1"
shift

# Also support --dry-run after subcommand
if [[ "${1:-}" == "--dry-run" && "$cmd" != "clean" ]]; then
    DRY_RUN=true
    shift
fi

case "$cmd" in
    plan|p)     cmd_plan "$@" ;;
    init)       cmd_init "$@" ;;
    apply)      cmd_apply "$@" ;;
    analyze)    cmd_analyze "$@" ;;
    state-list) cmd_state_list "$@" ;;
    state-show) cmd_state_show "$@" ;;
    state-rm)   cmd_state_rm "$@" ;;
    validate)   cmd_validate "$@" ;;
    output)     cmd_output "$@" ;;
    clean)      cmd_clean "$@" ;;
    -h|--help)  usage 0 ;;
    # Shortcuts: pass single-letter aliases through to analyze
    s|m|r|i|d|u|x|df|dr|mv|st|ap)
        cmd_analyze "$cmd" "$@" ;;
    # Full names also pass through to analyze
    summary|modules|resources|imports|details|updates|issues|diff|drift|moved|status|approve|report)
        cmd_analyze "$cmd" "$@" ;;
    *)          echo "Unknown command: $cmd" >&2; usage 1 ;;
esac
