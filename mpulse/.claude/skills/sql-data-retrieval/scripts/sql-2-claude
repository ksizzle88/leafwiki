#!/usr/bin/env python3
"""
sql-2-claude: Unified SQL query router.

Usage:
    sql-2-claude <query-name> -c <connection> [-t timeout] [--dry-run] [-- extra-args...]
    sql-2-claude raw -c <connection> -- <command...>
    sql-2-claude connections
    sql-2-claude clean [-c connection]
"""

from __future__ import annotations

import argparse
import datetime
import json
import shutil
import subprocess
import sys
from pathlib import Path

# Add scripts dir to path for local imports
sys.path.insert(0, str(Path(__file__).parent))

from lib.config import find_config, load_config, lookup_connection, list_connections
from lib.output import write_output, write_error, print_preview
from lib.resolve import project_name, find_query_sql, check_connection_safety


BASE_DIR = Path("/tmp/claude/sql")


def get_platform_module(platform: str):
    """Import and return the platform execution module."""
    if platform == "snowflake":
        from platforms import snowflake
        return snowflake
    elif platform == "postgres":
        from platforms import postgres
        return postgres
    elif platform == "mssql":
        from platforms import mssql
        return mssql
    else:
        print(f"Error: unknown platform '{platform}'", file=sys.stderr)
        sys.exit(1)


def cmd_query(args: argparse.Namespace, extra_args: list[str]) -> None:
    """Run a SQL query."""
    cfg = load_config()
    platform, env, conn_cfg = lookup_connection(args.connection, cfg)

    query_name = args.query_name.removesuffix(".sql")
    project = project_name()
    query_dir = BASE_DIR / project / env / query_name
    query_dir.mkdir(parents=True, exist_ok=True)

    # Find SQL file
    sql_path = find_query_sql(query_name, query_dir, env, BASE_DIR / project)
    if not sql_path:
        print(f"Error: SQL file not found. Searched:", file=sys.stderr)
        print(f"  {query_dir}/query.sql", file=sys.stderr)
        print(f"  {Path.cwd()}/{query_name}.sql", file=sys.stderr)
        sys.exit(1)

    # Connection safety check
    check_connection_safety(sql_path, args.connection)

    print(f"--- sql-2-claude ---")
    print(f"  Query:    {query_name}")
    print(f"  SQL:      {sql_path}")
    print(f"  Platform: {platform}")
    print(f"  Conn:     {args.connection} ({env})")
    print(f"  Timeout:  {args.timeout}s")
    print(f"---------------------")

    if args.dry_run:
        print(f"  [dry-run] would execute via {platform}")
        print(f"  Output: {query_dir}/")
        return

    # Execute
    mod = get_platform_module(platform)
    try:
        data = mod.execute(sql_path, args.connection, args.timeout, extra_args or None)
    except subprocess.TimeoutExpired:
        write_error(query_dir, f"Query timed out after {args.timeout}s", 124,
                    f"Re-authenticate or increase timeout (-t)")
        print(f"\nERROR: Query timed out after {args.timeout}s")
        print(f"  Error captured to: {query_dir}/")
        sys.exit(1)
    except Exception as e:
        write_error(query_dir, str(e), 1)
        print(f"\nERROR: {e}")
        print(f"  Error captured to: {query_dir}/")
        sys.exit(1)

    # Write output
    write_output(query_dir, data)
    print()
    print_preview(data, query_dir)
    print("\a", end="")


def cmd_raw(args: argparse.Namespace, raw_cmd: list[str]) -> None:
    """Run an arbitrary command and capture output."""
    if not raw_cmd:
        print("Error: no command after --", file=sys.stderr)
        sys.exit(1)

    cfg = load_config()
    _, env, _ = lookup_connection(args.connection, cfg)

    project = project_name()
    ts = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    query_dir = BASE_DIR / project / env / f"raw-{ts}"
    query_dir.mkdir(parents=True, exist_ok=True)
    out_path = query_dir / "out.txt"

    print(f"--- sql-2-claude raw ---")
    print(f"  Conn:    {args.connection} ({env})")
    print(f"  Command: {' '.join(raw_cmd)}")
    print(f"  Output:  {out_path}")
    print(f"------------------------")

    result = subprocess.run(raw_cmd, capture_output=True, text=True)
    output = result.stdout + result.stderr
    out_path.write_text(output)

    if result.returncode != 0:
        print(f"\nWARNING: command exited with code {result.returncode}")

    lines = output.splitlines()
    if len(lines) > 50:
        print("\n".join(lines[:50]))
        print(f"... ({len(lines)} lines total, showing first 50)")
    else:
        print(output)

    print(f"\nFull output: {out_path}")
    sys.exit(result.returncode)


def cmd_clean(args: argparse.Namespace) -> None:
    """Remove query folders."""
    project = project_name()
    project_dir = BASE_DIR / project

    if args.connection:
        cfg = load_config()
        _, env, _ = lookup_connection(args.connection, cfg)
        target = project_dir / env
    else:
        target = project_dir

    if not target.is_dir():
        print(f"Nothing to clean: {target}")
        return

    folders = [d for d in target.iterdir() if d.is_dir() and
               any((d / f).exists() for f in ("query.sql", "out.json", "out.md"))]

    if not folders:
        print(f"Nothing to clean in {target}")
        return

    print(f"SQL dir: {target}\n")
    for d in folders:
        if args.dry_run:
            print(f"  would delete: {d.name}/")
        else:
            print(f"  deleting: {d.name}/")
            shutil.rmtree(d)

    n = len(folders)
    print(f"\n{n} folder(s) {'would be ' if args.dry_run else ''}deleted.")


def main() -> None:
    parser = argparse.ArgumentParser(prog="sql-2-claude", description="Unified SQL query router")
    sub = parser.add_subparsers(dest="command")

    # query (default)
    q = sub.add_parser("query", help="Run a SQL query")
    q.add_argument("query_name", help="Query name (becomes folder name)")
    q.add_argument("-c", "--connection", required=True)
    q.add_argument("-t", "--timeout", type=int, default=120)
    q.add_argument("--dry-run", action="store_true")

    # raw
    r = sub.add_parser("raw", help="Run arbitrary command")
    r.add_argument("-c", "--connection", required=True)

    # connections
    sub.add_parser("connections", help="List all connections")

    # clean
    cl = sub.add_parser("clean", help="Remove query folders")
    cl.add_argument("-c", "--connection", default="")
    cl.add_argument("--dry-run", action="store_true")

    # Parse — handle the common case where query_name comes first without "query" subcommand
    argv = sys.argv[1:]
    if argv and argv[0] not in ("query", "raw", "connections", "clean", "-h", "--help") and not argv[0].startswith("-"):
        argv = ["query"] + argv

    # Split on -- for extra args passthrough
    extra_args = []
    if "--" in argv:
        idx = argv.index("--")
        extra_args = argv[idx + 1:]
        argv = argv[:idx]

    args = parser.parse_args(argv)

    if args.command == "connections":
        list_connections()
    elif args.command == "clean":
        cmd_clean(args)
    elif args.command == "raw":
        cmd_raw(args, extra_args)
    elif args.command == "query":
        cmd_query(args, extra_args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
