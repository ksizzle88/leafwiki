#!/usr/bin/env bash
set -euo pipefail

# snow-2-claude: Run a SQL query via Snowflake CLI, save dual output for Claude.
#
# Usage: snow-2-claude <query-name> -c connection [-t timeout] [--dry-run]
#        snow-2-claude <query-name> -c connection [--base-dir dir] [--env env]
#        snow-2-claude clean [--dry-run] [-c connection]
#
#   query-name   Name for this query (REQUIRED — becomes the folder name)
#   -c conn      Snowflake connection profile (REQUIRED)
#   -t timeout   Timeout in seconds (default: 120)
#   --base-dir   Override base directory (default: /tmp/claude/sql)
#   --env        Override env subfolder (default: derived from connection)
#   --dry-run    Print the command that would be executed, but don't run it
#   clean        Remove query folders
#
# Output per-query folder:
#   {env}/{query-name}/query.sql   The SQL file
#   {env}/{query-name}/out.json    Raw JSON
#   {env}/{query-name}/out.md      Markdown table

usage() {
    sed -n '3,20p' "$0" | sed 's/^# \?//'
    exit "${1:-0}"
}

resolve_project_name() {
    local root
    root="$(git rev-parse --show-toplevel 2>/dev/null)" || root="$PWD"
    basename "$root"
}

connection_to_env() {
    local conn="$1"
    case "$conn" in
        mp_de_qa)       echo "qa" ;;
        mp_de_stage)    echo "stage" ;;
        mp_de_prod)     echo "prod" ;;
        data_ops_dev)   echo "data_ops_dev" ;;
        data_ops_prod)  echo "data_ops_prod" ;;
        dpi_ml_prod)    echo "dpi_ml_prod" ;;
        edw-develop)    echo "edw_develop" ;;
        *)              echo "$conn" ;;
    esac
}

check_connection_safety() {
    local sql_file="$1" target_conn="$2"
    [[ ! -f "$sql_file" ]] && return 0
    local declared
    declared=$(head -5 "$sql_file" | grep -oP '(?<=-- connection: )\S+' || true)
    if [[ -n "$declared" ]] && [[ "$declared" != "$target_conn" ]]; then
        echo "" >&2
        echo "WARNING: query.sql was written for '$declared' but you're running with -c $target_conn" >&2
        echo "Press Enter to continue or Ctrl+C to abort..." >&2
        read -r
    fi
}

json_to_table() {
    local json_file="$1" max_rows="${2:-0}"
    if ! jq -e 'type == "array" and length > 0' "$json_file" >/dev/null 2>&1; then
        echo "(no rows returned)"; return
    fi
    local total_rows; total_rows=$(jq 'length' "$json_file")
    local -a headers; mapfile -t headers < <(jq -r '.[0] | keys_unsorted[]' "$json_file")
    local -a widths
    for i in "${!headers[@]}"; do
        local hdr="${headers[$i]}"
        local max_val_len; max_val_len=$(jq -r --arg k "$hdr" '[.[][$k] | tostring | length] | max // 0' "$json_file")
        local hdr_len=${#hdr}
        widths[$i]=$(( max_val_len > hdr_len ? max_val_len : hdr_len ))
        (( widths[$i] > 40 )) && widths[$i]=40
    done
    local header_line="| " separator="| "
    for i in "${!headers[@]}"; do
        header_line+="$(printf "%-${widths[$i]}s" "${headers[$i]}") | "
        separator+="$(printf '%0.s-' $(seq 1 "${widths[$i]}")) | "
    done
    echo "$header_line"; echo "$separator"
    local row_limit=$total_rows
    (( max_rows > 0 && max_rows < total_rows )) && row_limit=$max_rows
    jq -r --argjson limit "$row_limit" '.[:$limit][] | [to_entries[] | .value // "" | tostring | .[:40]] | @tsv' "$json_file" | while IFS=$'\t' read -ra vals; do
        local line="| "
        for i in "${!vals[@]}"; do
            line+="$(printf "%-${widths[$i]:-10}s" "${vals[$i]}") | "
        done
        echo "$line"
    done
    (( max_rows > 0 && total_rows > max_rows )) && echo "... ($max_rows of $total_rows rows shown)"
}

write_error() {
    local query_dir="$1" message="$2" exit_code="${3:-1}" suggestion="${4:-}"
    mkdir -p "$query_dir"
    echo "{\"error\": \"$message\", \"exit_code\": $exit_code}" > "$query_dir/out.json"
    { echo "## Error"; echo ""; echo "$message"; [[ -n "$suggestion" ]] && { echo ""; echo "$suggestion"; }; } > "$query_dir/out.md"
}

DEFAULT_BASE_DIR="/tmp/claude/sql"

# --- Clean subcommand ---
if [[ "${1:-}" == "clean" ]]; then
    shift; dry_run=false; connection=""; override_base_dir=""; override_env=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;; -c) connection="$2"; shift 2 ;;
            --base-dir) override_base_dir="$2"; shift 2 ;; --env) override_env="$2"; shift 2 ;;
            *) echo "Unknown option: $1" >&2; usage 1 ;;
        esac
    done
    base="${override_base_dir:-$DEFAULT_BASE_DIR}"; project_dir="$base/$(resolve_project_name)"
    if [[ -n "$override_env" ]]; then target_dir="$project_dir/$override_env"
    elif [[ -n "$connection" ]]; then target_dir="$project_dir/$(connection_to_env "$connection")"
    else target_dir="$project_dir"; fi
    [[ ! -d "$target_dir" ]] && { echo "Nothing to clean: $target_dir does not exist"; exit 0; }
    folders=()
    while IFS= read -r -d '' d; do
        [[ -f "$d/query.sql" || -f "$d/out.json" || -f "$d/out.md" ]] && folders+=("$d")
    done < <(find "$target_dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null)
    [[ ${#folders[@]} -eq 0 ]] && { echo "Nothing to clean in $target_dir"; exit 0; }
    echo "SQL dir: $target_dir"; echo ""
    for d in "${folders[@]}"; do
        $dry_run && echo "  would delete: $(basename "$d")/" || { echo "  deleting: $(basename "$d")/"; rm -rf "$d"; }
    done
    echo ""; $dry_run && echo "${#folders[@]} query folder(s) would be deleted." || echo "${#folders[@]} query folder(s) deleted."
    exit 0
fi

# --- Parse arguments ---
query_name=""; connection=""; dry_run=false; timeout_secs=120; override_base_dir=""; override_env=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) dry_run=true; shift ;; -c) connection="$2"; shift 2 ;; -t) timeout_secs="$2"; shift 2 ;;
        --base-dir) override_base_dir="$2"; shift 2 ;; --env) override_env="$2"; shift 2 ;;
        -h|--help) usage 0 ;; -f) echo "Note: -f deprecated." >&2; shift 2 ;;
        -*) echo "Unknown option: $1" >&2; usage 1 ;;
        *) [[ -z "$query_name" ]] && query_name="$1" || { echo "Error: unexpected argument '$1'" >&2; usage 1; }; shift ;;
    esac
done

[[ -z "$connection" ]] && { echo "Error: -c connection is required" >&2; usage 1; }
[[ -z "$query_name" ]] && { echo "Error: query name is required (becomes the folder name)" >&2; usage 1; }
query_name="${query_name%.sql}"
env="${override_env:-$(connection_to_env "$connection")}"

# --- Resolve directories ---
base_dir="${override_base_dir:-$DEFAULT_BASE_DIR}/$(resolve_project_name)"
query_dir="$base_dir/$env/$query_name"
mkdir -p "$query_dir"

# --- Find SQL file ---
sql_path=""
[[ -f "$query_dir/query.sql" ]] && sql_path="$query_dir/query.sql"
[[ -z "$sql_path" && -f "$query_name.sql" ]] && sql_path="$(pwd)/$query_name.sql"
[[ -z "$sql_path" && -f "$query_name" ]] && sql_path="$(pwd)/$query_name"
if [[ -z "$sql_path" ]]; then
    scan_root="${override_base_dir:-$DEFAULT_BASE_DIR}"
    for d in "$scan_root"/*/; do
        [[ -d "$d" ]] || continue
        [[ -f "$d$env/$query_name/query.sql" ]] && { sql_path="$d$env/$query_name/query.sql"; query_dir="$d$env/$query_name"; break; }
        [[ -f "$d$query_name.sql" ]] && { sql_path="$d$query_name.sql"; break; }
    done
fi
[[ -z "$sql_path" ]] && { echo "Error: SQL file not found. Searched:" >&2; echo "  $query_dir/query.sql" >&2; echo "  $(pwd)/$query_name.sql" >&2; exit 1; }

check_connection_safety "$sql_path" "$connection"

json_path="$query_dir/out.json"
md_path="$query_dir/out.md"

snow_args=(sql -f "$sql_path" --format JSON -c "$connection")

echo "--- snow-2-claude ---"
echo "  Query:   $query_name"
echo "  SQL:     $sql_path"
echo "  Conn:    $connection ($env)"
echo "  Timeout: ${timeout_secs}s"
echo "---------------------"

$dry_run && { echo "  [dry-run] would execute: snow ${snow_args[*]}"; echo "  Output: $query_dir/"; exit 0; }

snow_exit=0
timeout "$timeout_secs" snow "${snow_args[@]}" > "$json_path" 2>&1 || snow_exit=$?

echo ""
if [[ $snow_exit -eq 124 ]]; then
    write_error "$query_dir" "Query timed out after ${timeout_secs}s" 124 "Re-authenticate: snow connection test -c ${connection}"
    echo "ERROR: Query timed out after ${timeout_secs}s"; echo "  Error captured to: $query_dir/"; exit 1
elif [[ $snow_exit -ne 0 ]]; then
    error_msg=$(cat "$json_path" 2>/dev/null || echo "Unknown error")
    write_error "$query_dir" "snow exited with code $snow_exit: $error_msg" "$snow_exit"
    echo "ERROR: snow exited with code $snow_exit"; echo "  Error captured to: $query_dir/"; exit "$snow_exit"
fi

if jq -e 'type == "array"' "$json_path" >/dev/null 2>&1; then
    row_count=$(jq 'length' "$json_path"); echo "  Rows: $row_count"; echo ""
    json_to_table "$json_path" 0 > "$md_path"
    json_to_table "$json_path" 20
    echo ""; echo "  Folder: $query_dir/"; echo "  JSON:   $json_path"; echo "  Table:  $md_path"
else
    cp "$json_path" "$md_path"
    echo "  Output (non-tabular):"; head -20 "$json_path"; echo ""; echo "  Folder: $query_dir/"
fi
printf '\a'
