version: '3.8'

services:
  devcontainer:
    volumes:
      # Add your local project mounts here
      # Format: - /absolute/path/on/host:/workspace/workspace/folder-name:cached

      # Example:
      # - /home/username/workspaces/DPI_Analytics_DBT:/workspace/workspace/DPI_Analytics_DBT:cached
